#!/bin/sh
# offrails-check: mechanical gates for a Rust off Rails app. Exits non-zero on any error.
#
#   sh .offrails/tools/offrails-check [APP_DIR]      (in CI, and step 1 of the Definition of Done)
#   offrails check [APP_DIR]                         (the same script, through the CLI)
#
# It checks what prose can't enforce: the AGENTS.md header is consistent, every built acceptance
# criterion and every Security-table test exists, apps with accounts have the tenancy suites,
# and handlers make no unscoped lookups. It reads files only; it never builds or runs the app.
set -eu

usage() {
  cat <<'EOF'
Usage: offrails-check [APP_DIR]

Checks a Rust off Rails app (default: the current directory):
  header       AGENTS.md header is complete and consistent (.offrails/VERSION, UI_LIBRARY, web/)
  ac           every AC-<feature>-<n> in product/ (not struck through) is cited by a test
  security     every feature has the STRIDE Security table, and every test it names exists
               (a category that can't apply: | <Category> | n/a: <why> | — | — |)
  tenancy      TENANCY != none: tests/app/tenancy_test.rs and guard_test.rs exist and are registered
  guard        TENANCY != none: no unscoped lookups in src/{controllers,channels,graphql,api}
  env          every env var name in src/config.rs (a "SCREAMING_SNAKE" literal) is in .env.example
  ids          no id / *_id column is a 32-bit integer in migration/src, and no entity id is i32
  postgres     tests/app/support.rs reads TEST_DATABASE_URL (the suite can run on Postgres)
  bind         development listens on this machine only: no 0.0.0.0 literal bind in src/, config.rs
               reads APP_BIND, and kernel::hosts refuses foreign Host names (DNS rebinding)
  routes       docs/routes.md lists every ROUTES path (warning only)
  classes      app templates (outside templates/components, kernel, mailers) with long ad-hoc class
               lists on <button>, <input>, <select>, <textarea> or a button-like <a>: use the
               component kit (warning only; CLASS_LIST_MAX, default 8; silence one line with
               {# offrails-check: classes ok #}; a line an installed part ships as it is, in
               .offrails/template/parts/<part>/, is skipped: it is the part's)
  htmx         an hx-trigger with an event filter ([…]) in templates/: filters need eval, which the
               template's htmx-config turns off for the CSP (allowEval: false), so it never fires
               (warning only)

Exit status: 0 when there are no errors (warnings allowed), 1 otherwise, 2 on bad usage.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  -*) usage >&2; exit 2 ;;
esac
APP=${1:-.}
[ -d "$APP" ] || { printf 'offrails-check: %s is not a directory\n' "$APP" >&2; exit 2; }
cd "$APP"

errors=0
warnings=0
fail() { errors=$((errors + 1)); printf 'FAIL [%s] %s\n' "$1" "$2"; [ -z "${3:-}" ] || printf '     fix: %s\n' "$3"; }
warn() { warnings=$((warnings + 1)); printf 'WARN [%s] %s\n' "$1" "$2"; [ -z "${3:-}" ] || printf '     fix: %s\n' "$3"; }
pass() { printf 'ok   [%s] %s\n' "$1" "$2"; }

# Directories that may hold tests (Rust unit tests live in src/, browser tests in tests/e2e or web/).
test_dirs() { for d in tests src web/src web/e2e e2e; do [ -d "$d" ] && printf '%s\n' "$d"; done; return 0; }

# ---- header ------------------------------------------------------------------------------------
if [ ! -f AGENTS.md ]; then
  fail header "no AGENTS.md here: not a Rust off Rails app (run from the app root or pass APP_DIR)"
  # ---- htmx trigger filters (warning) -----------------------------------------------------------
# hx-trigger="keyup[key=='Enter']": htmx evaluates the filter with Function(), which the layout's
# htmx-config forbids (allowEval: false, for the CSP); the trigger then silently never fires.
if [ -d templates ]; then
  filter_hits=$(grep -rnE "hx-trigger=(\"[^\"]*\[|'[^']*\[)" templates 2>/dev/null || true)
  if [ -n "$filter_hits" ]; then
    printf '%s\n' "$filter_hits" | head -n 20 | while IFS= read -r h; do printf 'WARN [htmx] %s: an hx-trigger filter ([…]) never fires with allowEval: false\n' "$(printf '%s' "$h" | cut -d: -f1-2)"; done
    warnings=$((warnings + $(printf '%s\n' "$filter_hits" | wc -l | tr -d ' ')))
    printf '     fix: a plain event (hx-trigger="keyup changed delay:300ms"), or a delegated listener in static/app.js\n'
    printf '          that calls htmx.trigger(el, "my-event") for hx-trigger="my-event" (.offrails/guides/frontend-htmx.md#gotchas-agents-get-wrong)\n'
  elif find templates -name '*.html' 2>/dev/null | grep -q .; then
    pass htmx "no hx-trigger filters (they need eval, which the CSP setup turns off)"
  fi
fi

printf '\noffrails-check: %s error(s), %s warning(s)\n' "$errors" "$warnings"
  exit 1
fi

# hdr KEY: the word after "KEY:" in the AGENTS.md header (first occurrence), or empty.
hdr() {
  awk -v k="$1:" '{ for (i = 1; i < NF; i++) if ($i == k) { print $(i + 1); exit } }' AGENTS.md
}

MODE=$(hdr FRONTEND_MODE)
ISLANDS=$(hdr ISLANDS)
UI=$(hdr UI_LIBRARY)
TENANCY=$(hdr TENANCY)
header_ok=1

for key in FRAMEWORK FRONTEND_MODE ACCOUNTS TENANCY; do
  if ! grep -q "$key:" AGENTS.md; then
    fail header "AGENTS.md header has no $key line" "restore it from .offrails/blueprints/AGENTS.md"
    header_ok=0
  fi
done

case "$MODE" in
  htmx|inertia|spa|api|"") ;;
  *) fail header "FRONTEND_MODE is '$MODE'; expected htmx | inertia | spa | api"; header_ok=0 ;;
esac
case "$TENANCY" in
  per-user|teams|shared|none|"") ;;
  *) fail header "TENANCY is '$TENANCY'; expected per-user | teams | shared | none"; header_ok=0 ;;
esac

needs_ui=0
case "$MODE" in inertia|spa) needs_ui=1 ;; esac
[ "$ISLANDS" = yes ] && needs_ui=1
if [ "$needs_ui" = 1 ]; then
  case "$UI" in
    react|svelte) ;;
    *) fail header "FRONTEND_MODE: $MODE, ISLANDS: ${ISLANDS:-no} needs UI_LIBRARY: react | svelte (found '${UI:-none}')" \
         "set UI_LIBRARY to the library web/ is written in"; header_ok=0 ;;
  esac
  if [ ! -d web ]; then
    fail header "FRONTEND_MODE: $MODE, ISLANDS: ${ISLANDS:-no} needs a web/ directory, and there is none" \
      "set ISLANDS: no (and FRONTEND_MODE) to what the app really is, or generate web/ per .offrails/guides"
    header_ok=0
  fi
fi

fw_line=$(grep -m1 'FRAMEWORK:' AGENTS.md || true)
fw_header=$(printf '%s\n' "$fw_line" | grep -o '[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*' | head -n1 || true)
fw_vendored=$(head -n1 .offrails/VERSION 2>/dev/null | tr -d '[:space:]' || true)
if [ -z "$fw_vendored" ]; then
  fail header ".offrails/VERSION is missing" "vendor the framework (generators/new.md step 1) or run offrails upgrade"
  header_ok=0
elif [ -n "$fw_line" ] && [ "$fw_header" != "$fw_vendored" ]; then
  fail header "AGENTS.md says FRAMEWORK ${fw_header:-?}, but .offrails/VERSION is $fw_vendored" \
    "finish the upgrade (.offrails/generators/upgrade.md), then set the FRAMEWORK line to $fw_vendored"
  header_ok=0
fi
[ "$header_ok" = 1 ] && pass header "FRONTEND_MODE=$MODE TENANCY=${TENANCY:-?} FRAMEWORK=$fw_vendored"

# ---- acceptance criteria -------------------------------------------------------------------------
if [ -d product ]; then
  dirs=$(test_dirs)
  ac_total=0; ac_missing=0; ac_unticked=0
  # Definition lines: "- [x] AC-x-1: …", "- [ ] AC-x-1: …" or "- AC-x-1: …". Struck (~~AC-…~~) ones are dropped.
  ac_lines=$(grep -rhE '^[[:space:]]*[-*][[:space:]]+(\[[ xX]\][[:space:]]+)?AC-[A-Za-z0-9_-]+-[0-9]+' product 2>/dev/null \
    | grep -v '~~AC-' || true)
  ac_ids=$(printf '%s\n' "$ac_lines" | grep -oE 'AC-[A-Za-z0-9_-]+-[0-9]+' | sort -u || true)
  for id in $ac_ids; do
    ac_total=$((ac_total + 1))
    file=$(grep -rlE "$id([^0-9]|\$)" product | head -n1)
    # shellcheck disable=SC2086  # $dirs is a newline-separated list of directory names
    if [ -z "$dirs" ] || ! grep -rqE "$id([^0-9]|\$)" $dirs 2>/dev/null; then
      ac_missing=$((ac_missing + 1))
      fail ac "$id ($file) is not cited by any test" \
        "write the test that proves it, with '/// $id' in its doc comment (strike the criterion through if the human dropped it)"
    elif printf '%s\n' "$ac_lines" | grep -E "$id([^0-9]|\$)" | grep -q '\[ \]'; then
      ac_unticked=$((ac_unticked + 1))
      warn ac "$id ($file) is cited by a test but still unticked" "tick it ([x]) once that test passes on SQLite and Postgres"
    fi
  done
  [ "$ac_missing" = 0 ] && pass ac "$ac_total acceptance criteria, all cited by tests"
else
  warn ac "no product/ directory: no specs to trace"
fi

# ---- Security tables ----------------------------------------------------------------------------
if [ -d product/features ]; then
  sec_total=0; sec_bad=0; sec_na=0
  for spec in product/features/*.md; do
    [ -f "$spec" ] || continue
    section=$(awk '/^## /{ s = ($0 ~ /^## Security/) } s' "$spec")
    if [ -z "$section" ]; then
      sec_bad=$((sec_bad + 1))
      fail security "$spec has no '## Security' section" \
        "add the threat model table from .offrails/blueprints/feature-spec.md (every threat: a control and a test)"
      continue
    fi
    if ! printf '%s\n' "$section" | grep -qE '^\|.*STRIDE.*\|.*Test[[:space:]]*\|'; then
      sec_bad=$((sec_bad + 1))
      fail security "$spec: the Security section isn't the STRIDE table (| STRIDE | Threat | Control | Test |)" \
        "rewrite it as the table from .offrails/blueprints/feature-spec.md, one row per threat, naming a test in each"
      continue
    fi
    rows=$(printf '%s\n' "$section" | grep -E '^\|' | grep -vE '^\|[[:space:]]*-' | grep -v 'STRIDE')
    # One row per line; the Test cell is the last one. "…" and {{placeholders}} are unfinished rows.
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      cell=$(printf '%s\n' "$row" | awk -F'|' '{ print $(NF - 1) }')
      # shellcheck disable=SC2016  # literal backticks
      names=$(printf '%s\n' "$cell" | grep -oE '`[A-Za-z0-9_:]+`' | tr -d '`' | sed 's/.*:://' \
        | grep -E '^[a-z_][a-z0-9_]*$' || true)
      threat=$(printf '%s\n' "$row" | awk -F'|' '{ gsub(/^[[:space:]]+|[[:space:]]+$/, "", $3); print $3 }')
      # A STRIDE category that doesn't apply: "n/a: <why>" in the Threat column, Test may be "—".
      if [ -z "$names" ] && printf '%s\n' "$threat" | grep -qiE '^n/a:[[:space:]]*[^[:space:]]'; then
        sec_na=$((sec_na + 1))
        continue
      fi
      if [ -z "$names" ] && printf '%s\n' "$threat" | grep -qiE '^(n/a|none|—|-)[[:space:].:]*$'; then
        sec_bad=$((sec_bad + 1))
        fail security "$spec: a threat row says \"$threat\" with no reason" \
          "write it as | <Category> | n/a: <why it can't happen here> | — | — |, or name the threat and its test"
        continue
      fi
      if [ -z "$names" ]; then
        sec_bad=$((sec_bad + 1))
        fail security "$spec: threat \"$threat\" names no test (\`test_name\` in the Test column)" \
          "write the test that proves the control and name it there"
        continue
      fi
      for name in $names; do
        sec_total=$((sec_total + 1))
        # shellcheck disable=SC2046  # word-split the directory list on purpose
        if ! grep -rqE "fn ${name}[[:space:]]*[(<]" $(test_dirs) 2>/dev/null; then
          sec_bad=$((sec_bad + 1))
          fail security "$spec names test \`$name\` (threat \"$threat\"), and no test has that name" \
            "write the test (it's the control's proof), or rename the entry to the test that exists"
        fi
      done
    done <<ROWS
$rows
ROWS
  done
  [ "$sec_bad" = 0 ] && pass security "$sec_total Security-table tests, all present ($sec_na n/a rows, each with its reason)"
fi

# ---- tenancy suites -----------------------------------------------------------------------------
if [ -n "$TENANCY" ] && [ "$TENANCY" != none ]; then
  for f in tenancy_test guard_test; do
    if [ ! -f "tests/app/$f.rs" ]; then
      fail tenancy "TENANCY: $TENANCY but tests/app/$f.rs is missing" \
        "generate it from .offrails/guides/test-standards.md#4-tenant-isolation-suite-every-app-with-accounts"
    elif ! grep -qE "^[[:space:]]*mod $f;" tests/app/main.rs 2>/dev/null; then
      fail tenancy "tests/app/$f.rs exists but tests/app/main.rs has no 'mod $f;', so it never runs" \
        "add 'mod $f;' to tests/app/main.rs"
    else
      pass tenancy "tests/app/$f.rs present and registered"
    fi
  done
  if [ -f tests/app/tenancy_test.rs ] && ! grep -q 'ROUTES' tests/app/tenancy_test.rs; then
    fail tenancy "tests/app/tenancy_test.rs doesn't iterate ROUTES, so new routes go untested" \
      "rebuild it from the §4 template (it loops over ROUTES)"
  fi
fi

# ---- guard patterns -----------------------------------------------------------------------------
if [ -n "$TENANCY" ] && [ "$TENANCY" != none ]; then
  hdirs=""
  for d in src/controllers src/channels src/graphql src/api; do [ -d "$d" ] && hdirs="$hdirs $d"; done
  guard_hits=0
  if [ -n "$hdirs" ]; then
    for pattern in 'RequireUser(_' 'ApiUser(_' '::find(' '::destroy(' '::all(' '::find_system(' 'Entity::find'; do
      # shellcheck disable=SC2086  # $hdirs is a space-separated list of directory names
      hits=$(grep -rnF --include='*.rs' -e "$pattern" $hdirs 2>/dev/null \
        | grep -vF '// unscoped:' \
        | awk -F: '{ line = $0; sub(/^[^:]*:[^:]*:[[:space:]]*/, "", line); if (line !~ /^\/\//) print $1 ":" $2 }' || true)
      for h in $hits; do
        guard_hits=$((guard_hits + 1))
        errors=$((errors + 1))
        # shellcheck disable=SC2016  # literal backticks
        printf 'FAIL [guard] %s: `%s` in a handler (unscoped data access)\n' "$h" "$pattern"
      done
    done
    if [ "$guard_hits" = 0 ]; then
      pass guard "no unscoped lookups in$hdirs"
    else
      printf '     fix: look records up with <model>::find_for(db, &user, id) / all_for / destroy_for\n'
      printf '          (.offrails/guides/models.md#scoped-lookups-tenancy). Public by spec: end the line\n'
      printf "          with '// unscoped: <AC id or reason>'.\n"
    fi
  fi
fi

# ---- env vars ----------------------------------------------------------------------------------
# Every env var name config.rs reads is a SCREAMING_SNAKE string literal, whatever helper reads it
# (std::env::var("X"), a var("X") closure, parse("X", default)…). Each must be in .env.example.
if [ -f src/config.rs ]; then
  vars=$(grep -v 'not an env var' src/config.rs | grep -oE '"[A-Z][A-Z0-9_]{2,}"' | tr -d '"' | sort -u)
  if [ ! -f .env.example ]; then
    fail env "src/config.rs reads env vars but there is no .env.example" \
      "add .env.example with every variable, one line each (.offrails/guides/config.md#envexample)"
  else
    env_missing=""
    env_total=0
    for v in $vars; do
      env_total=$((env_total + 1))
      grep -qE "^(# ?)?$v=" .env.example || env_missing="$env_missing $v"
    done
    if [ -n "$env_missing" ]; then
      fail env ".env.example is missing variable(s) src/config.rs reads:$env_missing" \
        "add each as NAME=value or # NAME=value with a comment (.offrails/guides/config.md#envexample); a literal that isn't an env var gets a trailing // not an env var"
    else
      pass env "$env_total env vars in src/config.rs, all in .env.example"
    fi
  fi
fi

# ---- 64-bit ids ---------------------------------------------------------------------------------
# Ids and foreign keys are i64 in Rust and must be BIGINT in the database. A 32-bit column (`.integer()`,
# `integer(X::TeamId)`, `pk_auto`) is INTEGER on SQLite, which is 64-bit anyway, so the SQLite suite
# passes; on Postgres it's INT4 and every write that returns an id fails to decode as i64 (a 500).
# A migration repaired by a later one says so: `// offrails-check: ids widened in m<…>` (that file must exist).
IDENT='([A-Za-z_][A-Za-z0-9_]*::([A-Z][A-Za-z0-9]*)?Id|Alias::new\([[:space:]]*"(id|[a-z0-9_]*_id)"[[:space:]]*\))'
HELPER_RE="(^|[^A-Za-z0-9_])(pk_auto|integer|integer_null|integer_uniq|small_integer|small_integer_null|small_integer_uniq|tiny_integer|tiny_integer_null|tiny_integer_uniq)\\([[:space:]]*${IDENT}[[:space:]]*\\)"
COLDEF_RE="ColumnDef::new\\([[:space:]]*${IDENT}[[:space:]]*\\)([[:space:]]*\\.[a-z_]+\\([^()]*\\))*[[:space:]]*\\.(integer|small_integer|tiny_integer)\\(\\)"
ids_bad=0; ids_files=0
for f in migration/src/m*.rs; do
  [ -f "$f" ] || continue
  ids_files=$((ids_files + 1))
  widened=$(grep -oE 'offrails-check: ids widened in m[A-Za-z0-9_]+' "$f" | head -n1 | awk '{ print $NF }' || true)
  if [ -n "$widened" ]; then
    if [ ! -f "migration/src/$widened.rs" ]; then
      ids_bad=$((ids_bad + 1))
      fail ids "$f says its ids are widened in $widened, and migration/src/$widened.rs doesn't exist" \
        "write that migration (.offrails/guides/migrations.md#ids-are-64-bit), or name the one that exists"
    fi
    continue
  fi
  # Join lines, so a ColumnDef chain split over several lines still matches.
  # One line per offending definition; its first identifier is the column.
  hits=$(tr '\n' ' ' < "$f" | grep -oE -e "$HELPER_RE" -e "$COLDEF_RE" \
    | while IFS= read -r def; do printf '%s\n' "$def" | grep -oE "$IDENT" | head -n1 | tr -d '[:space:]'; echo; done || true)
  for h in $hits; do
    ids_bad=$((ids_bad + 1))
    fail ids "$f: $h is a 32-bit integer column; ids and foreign keys must be 64-bit (INT4 on Postgres breaks every i64 id)" \
      "use big_pk_auto / big_integer(_null) (.offrails/guides/migrations.md#ids-are-64-bit); an applied migration stays as it is: widen it in a new one"
  done
done
for d in src entity/src; do
  [ -d "$d" ] || continue
  ehits=$(grep -rnE --include='*.rs' '^[[:space:]]*pub[[:space:]]+(id|[a-z0-9_]+_id)[[:space:]]*:[[:space:]]*(Option<)?(i32|i16|u32|u16)[[:space:]]*>?[[:space:]]*,' "$d" 2>/dev/null \
    | grep -vF '// not a db id' | awk -F: '{ print $1 ":" $2 }' || true)
  for h in $ehits; do
    ids_bad=$((ids_bad + 1))
    fail ids "$h: an id field typed i32/i16 (entity ids and foreign keys are i64)" \
      "make it i64 (and the column big_integer); a field that isn't a database id gets a trailing // not a db id"
  done
done
[ "$ids_files" -gt 0 ] && [ "$ids_bad" = 0 ] && pass ids "$ids_files migrations, every id and *_id column 64-bit"

# ---- tests run on Postgres too ------------------------------------------------------------------
if [ -f tests/app/support.rs ]; then
  if grep -q 'TEST_DATABASE_URL' tests/app/support.rs; then
    pass postgres "tests/app/support.rs reads TEST_DATABASE_URL"
  else
    fail postgres "tests/app/support.rs never reads TEST_DATABASE_URL, so the suite can only run on SQLite" \
      "TestApp::new connects to TEST_DATABASE_URL when it's set (a database per test: .offrails/guides/testing.md#database-per-test), then run the suite on Postgres"
  fi
fi

# ---- development is this machine only ----------------------------------------------------------
# /dev has no login (the mailbox holds every sign-in link). Development binds 127.0.0.1 (APP_BIND) and
# refuses Host names that aren't this machine (DNS rebinding reaches it same-origin, past CSRF).
# A 0.0.0.0 literal that isn't the server's bind ends its line with `// not the server bind`.
if [ -f src/main.rs ]; then
  bind_bad=0
  lits=$(grep -rnE --include='*.rs' '\[0, *0, *0, *0\]|"0\.0\.0\.0(:|")|Ipv[46]Addr::UNSPECIFIED' src 2>/dev/null \
    | grep -v '^src/config\.rs:' | grep -vF '// not the server bind' | grep -vE '^[^:]+:[0-9]+:[[:space:]]*//' \
    | awk -F: '{ print $1 ":" $2 }' || true)
  for h in $lits; do
    bind_bad=$((bind_bad + 1))
    fail bind "$h: a literal 0.0.0.0 bind; development must listen on 127.0.0.1 (its /dev tools have no login)" \
      "bind SocketAddr::new(config.bind, port) (APP_BIND: .offrails/guides/config.md#where-serve-listens-app_bind-app_allowed_hosts-and-the-unset-app_env-warning); not the server's bind: end the line with // not the server bind"
  done
  if [ -f src/config.rs ] && ! grep -q '"APP_BIND"' src/config.rs; then
    bind_bad=$((bind_bad + 1))
    fail bind "src/config.rs never reads APP_BIND, so development can't default to 127.0.0.1" \
      "add Config.bind via config::bind_address (127.0.0.1 in development, 0.0.0.0 otherwise) and serve on it (.offrails/guides/config.md)"
  fi
  if [ -f src/routes.rs ] && ! grep -rqE --include='*.rs' 'hosts::middleware|AllowedHosts' src 2>/dev/null; then
    bind_bad=$((bind_bad + 1))
    fail bind "no Host check: development answers any Host name, so a DNS-rebinding page can read /dev same-origin" \
      "add src/kernel/hosts.rs and mount it inside the security middleware (.offrails/guides/security.md#development-is-this-machine-only)"
  fi
  [ "$bind_bad" = 0 ] && pass bind "serve binds APP_BIND (127.0.0.1 in development) and development checks Host"
fi

# ---- docs/routes.md -----------------------------------------------------------------------------
if [ -f src/routes.rs ] && grep -q 'pub const ROUTES' src/routes.rs; then
  # Every `("GET", "/path", …)` row: src/routes.rs's own tables and each feature's src/routes/*.rs.
  route_files=src/routes.rs
  for f in src/routes/*.rs; do [ -f "$f" ] && route_files="$route_files $f"; done
  # shellcheck disable=SC2086  # a space-separated list of file names
  paths=$(grep -hE '^[[:space:]]*\("[A-Z]+",[[:space:]]*"/' $route_files | grep -oE '"/[^"]*"' | tr -d '"' | sort -u)
  if [ ! -f docs/routes.md ]; then
    warn routes "docs/routes.md is missing" "cargo run -- routes"
  else
    stale=""
    for p in $paths; do
      grep -qF -- "$p" docs/routes.md || stale="$stale $p"
    done
    if [ -n "$stale" ]; then
      warn routes "docs/routes.md is missing ROUTES path(s):$stale" "cargo run -- routes"
    else
      pass routes "docs/routes.md lists every ROUTES path"
    fi
  fi
fi

# ---- component classes (warning) ----------------------------------------------------------------
# A <button> with fourteen utilities is the kit written out by hand: it drifts from the brand and
# from dark mode one copy at a time. templates/components/ui.html (and the .btn/.input classes in
# assets/app.css) say it in a few words. A deliberate one ends its line with
# {# offrails-check: classes ok #} (a reason after "ok" is welcome).
# A line a part ships as it is (in .offrails/template/parts/<part>/files/<the same path>, crate names
# aside, or in a part's wiring, sample.toml) is skipped: moving it onto the kit is the part's job,
# in rust-off-rails/samples, and update-part merges from that copy. A line the app wrote or edited
# is the app's, and checked.
crate_name=$(awk -F'"' '/^name *= */ { print $2; exit }' Cargo.toml 2>/dev/null || true)
if [ -d templates ]; then
  part_lines=$(mktemp)
  class_out=$(find templates -name '*.html' ! -path 'templates/components/*' ! -path 'templates/kernel/*' \
      ! -path 'templates/mailers/*' 2>/dev/null | sort | while IFS= read -r f; do
    {
      for pf in .offrails/template/parts/*/files/"$f"; do
        [ -f "$pf" ] && sed -e "s/offrails_host/$crate_name/g" -e "s/offrails_app/$crate_name/g" "$pf"
      done
      for st in .offrails/template/parts/*/sample.toml; do
        [ -f "$st" ] && cat "$st"
      done
    } > "$part_lines"
    awk -v f="$f" -v max="${CLASS_LIST_MAX:-8}" -v pl="$part_lines" '
      function trim(x) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); return x }
      FILENAME == pl { shipped[trim($0)] = 1; next }
      /offrails-check: classes ok/ { next }
      {
        rest = $0
        while (match(rest, /<(button|input|select|textarea|a)[[:space:]][^>]*class="[^"]*"/)) {
          tag = substr(rest, RSTART, RLENGTH)
          rest = substr(rest, RSTART + RLENGTH)
          name = tag; sub(/^</, "", name); sub(/[[:space:]].*/, "", name)
          cls = tag; sub(/.*class="/, "", cls); sub(/"$/, "", cls)
          gsub(/[{][{][^}]*[}][}]|[{]%[^%]*%[}]/, " ", cls)
          n = split(cls, parts, /[[:space:]]+/)
          count = 0
          for (i = 1; i <= n; i++) if (parts[i] != "") count++
          if (name == "a" && !(cls ~ /(^|[[:space:]])bg-/ && cls ~ /(^|[[:space:]])px-/)) continue
          if (count <= max) continue
          if (trim($0) in shipped) printf "PART %s:%d\n", f, FNR
          else printf "%s:%d: <%s> with %d classes\n", f, FNR, name, count
        }
      }' "$part_lines" "$f"
  done)
  rm -f "$part_lines"
  class_hits=$(printf '%s\n' "$class_out" | grep -v '^PART ' | grep . || true)
  part_hits=$(printf '%s\n' "$class_out" | grep -c '^PART ' || true)
  if [ -n "$class_hits" ]; then
    printf '%s\n' "$class_hits" | head -n 20 | while IFS= read -r h; do printf 'WARN [classes] %s\n' "$h"; done
    total=$(printf '%s\n' "$class_hits" | wc -l | tr -d ' ')
    warnings=$((warnings + total))
    [ "$total" -gt 20 ] && printf '     … and %s more\n' "$((total - 20))"
    # shellcheck disable=SC2016  # literal braces and backticks
    printf '     fix: {%% import "components/ui.html" as ui %%} and {%% call ui::button(…) %%}{%% endcall %%}, ui::field, ui::link_button…\n'
    printf '          or the classes .btn .btn-secondary .btn-sm .input (.offrails/guides/views.md#components);\n'
    printf '          a deliberate one: end the line with {# offrails-check: classes ok #}\n'
  elif find templates -name '*.html' 2>/dev/null | grep -q .; then
    pass classes "no long ad-hoc class lists on buttons and inputs"
  fi
  if [ "${part_hits:-0}" -gt 0 ]; then
    printf '     [classes] skipped %s line(s) the installed parts ship as they are (the samples repo moves them onto the kit)\n' "$part_hits"
  fi
fi

# ---- htmx trigger filters (warning) -----------------------------------------------------------
# hx-trigger="keyup[key=='Enter']": htmx evaluates the filter with Function(), which the layout's
# htmx-config forbids (allowEval: false, for the CSP); the trigger then silently never fires.
if [ -d templates ]; then
  filter_hits=$(grep -rnE "hx-trigger=(\"[^\"]*\[|'[^']*\[)" templates 2>/dev/null || true)
  if [ -n "$filter_hits" ]; then
    printf '%s\n' "$filter_hits" | head -n 20 | while IFS= read -r h; do printf 'WARN [htmx] %s: an hx-trigger filter ([…]) never fires with allowEval: false\n' "$(printf '%s' "$h" | cut -d: -f1-2)"; done
    warnings=$((warnings + $(printf '%s\n' "$filter_hits" | wc -l | tr -d ' ')))
    printf '     fix: a plain event (hx-trigger="keyup changed delay:300ms"), or a delegated listener in static/app.js\n'
    printf '          that calls htmx.trigger(el, "my-event") for hx-trigger="my-event" (.offrails/guides/frontend-htmx.md#gotchas-agents-get-wrong)\n'
  elif find templates -name '*.html' 2>/dev/null | grep -q .; then
    pass htmx "no hx-trigger filters (they need eval, which the CSP setup turns off)"
  fi
fi

printf '\noffrails-check: %s error(s), %s warning(s)\n' "$errors" "$warnings"
[ "$errors" = 0 ]
