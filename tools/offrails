#!/bin/sh
# offrails: the Rust off Rails command. Installed by install.sh to ~/.local/bin/offrails.
# It never writes app code; it starts your coding agent with the right instructions.
set -eu

OFFRAILS_HOME="${OFFRAILS_HOME:-$HOME/.offrails}"
BIN_DIR="${OFFRAILS_BIN_DIR:-$HOME/.local/bin}"
FW="$OFFRAILS_HOME/current"
INSTALLER_URL="https://rustoffrails.org/install.sh"

have() { command -v "$1" >/dev/null 2>&1; }
die()  { printf 'offrails: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
offrails: Rust off Rails, the opinionated web stack for the AI era

Usage:
  offrails new <name> [pitch…]   start a new app with your coding agent (Claude Code, opencode or Codex)
  offrails upgrade [--check] [--fw <dir>]  in an app: bring it up to the installed framework, or to <dir>
                                 (a release tag export or the plugin root; runs your agent)
  offrails check [dir]           in an app: the mechanical gates (header, specs ↔ tests, tenancy, guard)
  offrails doctor                check prerequisites and versions
  offrails version               show the installed framework version
  offrails update [options]      install the latest framework release (then run `offrails upgrade` in each app)
  offrails uninstall             remove the framework and this command
  offrails help [command]        this help, or a command's (same as offrails <command> --help)

Examples:
  offrails new bookshelf "people track the books they've read"
  offrails update --version 0.3.0
  cd my-app && offrails upgrade --check
  cd my-app && offrails upgrade --check --fw /tmp/offrails-0.6.0   # a tag export: git archive v0.6.0 | tar -x -C …

`offrails <command> --help` (or -h) prints that command's help and never runs anything.
Commands that start an agent (new, upgrade) need --yes (or OFFRAILS_YES=1) when stdin is not a
terminal; without it they print the agent command they would run and exit 3.

Exit codes: 0 ok · 1 error · 2 usage (unknown command or flag) · 3 agent launch needs --yes
            10 upgrade --check: an upgrade is due
EOF
}

# help_for <command>: per-command help (stdout, exit 0 from the caller). Never does any work.
help_for() {
  case "$1" in
    new) cat <<'EOF'
Usage: offrails new [--yes] <name> [pitch…]

Starts your coding agent (Claude Code, opencode or Codex; OFFRAILS_AGENT picks one) with
/offrails:new, which interviews you and generates the app. Writes nothing itself.
  <name>     lowercase letters, digits, '-' or '_', starting with a letter
  --yes, -y  launch the agent even when stdin is not a terminal (or OFFRAILS_YES=1)
EOF
    ;;
    upgrade) cat <<'EOF'
Usage: offrails upgrade [--check] [--fw <dir>] [--yes]

In an app: compare its .offrails/ with the installed framework (or <dir>) and, when they
differ, start your coding agent with the upgrade recipe (generators/upgrade.md).
  --check     compare only; exit 0 when current, 10 when an upgrade is due. Never runs an agent.
  --fw <dir>  a framework release (tag export or plugin root) instead of ~/.offrails/current
  --yes, -y   launch the agent even when stdin is not a terminal (or OFFRAILS_YES=1)
EOF
    ;;
    check) cat <<'EOF'
Usage: offrails check [dir]

Runs the app's mechanical gates (header, specs <-> tests, tenancy suites, scoped lookups) with the
app's vendored .offrails/tools/offrails-check, or the installed one for older apps. Exit 0 = clean.
EOF
    ;;
    doctor) cat <<'EOF'
Usage: offrails doctor

Checks prerequisites (Rust, cargo tools, Docker, Node, agents) and the installed framework.
EOF
    ;;
    version) cat <<'EOF'
Usage: offrails version

Prints the installed framework version and where it lives.
EOF
    ;;
    update) cat <<'EOF'
Usage: offrails update [installer options]

Downloads and runs the latest installer (rustoffrails.org/install.sh), then run
`offrails upgrade` in each app. Installer options (e.g. --version 0.6.0, --yes) pass through.
EOF
      if [ -f "$FW/install.sh" ]; then printf '\n'; sh "$FW/install.sh" --help 2>/dev/null | sed -n '/^Options/,$p' || true; fi
    ;;
    uninstall) cat <<'EOF'
Usage: offrails uninstall [--yes]

Removes ~/.offrails and the offrails command. Apps, Rust and cargo tools are not touched.
  --yes, -y  don't ask
EOF
    ;;
    *) usage ;;
  esac
}

usage_error() { printf 'offrails: %s\n\n' "$2" >&2; help_for "$1" >&2; exit 2; }

framework_version() { head -n1 "$FW/VERSION" 2>/dev/null || echo "not installed"; }

cmd_version() {
  printf 'Rust off Rails %s\n' "$(framework_version)"
  printf 'framework: %s\n' "$(cd "$FW" 2>/dev/null && pwd -P || echo "$FW (missing)")"
}

# launch_agent <claude-prompt> <generic-prompt>: Claude Code (plugin skill) > opencode > Codex > print.
# Without a terminal on stdin (CI, a script, another agent) it needs --yes / OFFRAILS_YES=1: an
# accidental call must never start an agent that edits the app. Otherwise it prints the command, exits 3.
launch_agent() {
  agent=""
  for a in claude opencode codex; do
    if { [ -z "${OFFRAILS_AGENT:-}" ] || [ "$OFFRAILS_AGENT" = "$a" ]; } && have "$a"; then agent=$a; break; fi
  done
  if [ -z "$agent" ]; then
    printf 'No supported agent found (Claude Code, opencode, Codex). Paste this into your coding agent:\n\n  %s\n\n' "$2"
    return 0
  fi
  if [ ! -t 0 ] && [ -z "$YES" ] && [ "${OFFRAILS_YES:-}" != 1 ]; then
    case "$agent" in
      claude) printf 'Would run: claude %s\n' "$1" ;;
      opencode) printf 'Would run: opencode run "%s"\n' "$2" ;;
      codex) printf 'Would run: codex "%s"\n' "$2" ;;
    esac
    printf 'offrails: stdin is not a terminal; not starting an agent. Re-run with --yes (or OFFRAILS_YES=1) to launch it.\n' >&2
    exit 3
  fi
  case "$agent" in
    claude) exec claude "$1" ;;
    opencode) exec opencode run "$2" ;;
    codex) exec codex "$2" ;;
  esac
}

cmd_new() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes) YES=1; shift ;;
      --) shift; break ;;
      -*) usage_error new "unknown option: $1" ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || usage_error new "missing <name>"
  name=$1; shift
  case "$name" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*|[!abcdefghijklmnopqrstuvwxyz]*) die "app name must start with a letter and use lowercase letters, digits, '-' or '_' (got '$name')" ;;
  esac
  pitch="$*"
  [ -f "$FW/AGENTS.md" ] || die "framework not installed; run the installer: curl -fsSL $INSTALLER_URL | sh"
  launch_agent "/offrails:new $name${pitch:+ $pitch}" \
    "Read $FW/AGENTS.md and make me a new Rust off Rails app called $name${pitch:+: $pitch}"
}

cmd_upgrade() {
  check=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) check=1 ;;
      --fw) [ $# -ge 2 ] || usage_error upgrade "--fw needs a directory"; FW=$2; shift ;;
      --fw=*) FW=${1#--fw=} ;;
      -y|--yes) YES=1 ;;
      *) usage_error upgrade "unknown option: $1" ;;
    esac
    shift
  done
  [ -f .offrails/VERSION ] || die "run this in a Rust off Rails app (no .offrails/ here)"
  [ -f "$FW/hooks/fingerprint.sh" ] || die "no framework at $FW (--fw needs a release: tag export or plugin root); or run the installer: curl -fsSL $INSTALLER_URL | sh"
  app_v=$(head -n1 .offrails/VERSION); fw_v=$(framework_version)
  app_fp=$(sh "$FW/hooks/fingerprint.sh" .offrails 2>/dev/null || bash "$FW/hooks/fingerprint.sh" .offrails)
  fw_fp=$(sh "$FW/hooks/fingerprint.sh" "$FW" 2>/dev/null || bash "$FW/hooks/fingerprint.sh" "$FW")
  if [ "$app_fp" = "$fw_fp" ]; then
    printf 'Up to date: this app vendors Rust off Rails %s (same content as the installed framework).\n' "$app_v"
    printf 'For newer releases: offrails update, then offrails upgrade again.\n'
    return 0
  fi
  printf 'This app vendors Rust off Rails %s; the installed framework is %s (content %s vs %s).\n' "$app_v" "$fw_v" "$app_fp" "$fw_fp"
  [ -n "$check" ] && return 10
  launch_agent "/offrails:upgrade" \
    "Upgrade this Rust off Rails app from $app_v to $fw_v. Follow $FW/generators/upgrade.md step by step with FW=$FW (a release; never use a framework working tree). Read $FW/CHANGELOG.md for the App migration steps between those versions. Reconcile, don't re-create; never edit applied migrations. Start from a clean git tree, show me the plan before changing anything, and finish with the Definition of Done on SQLite and Postgres."
}

row() { printf '  %-14s %-10s %s\n' "$1" "$2" "$3"; }
probe() { # name, required(yes/no), binary, version command…
  n=$1; req=$2; bin=$3; shift 3
  if have "$bin"; then
    v=$("$@" 2>/dev/null | head -n1 | sed 's/^[^0-9]*//; s/[ (,].*//')
    row "$n" "ok" "${v:-installed}"
  elif [ "$req" = yes ]; then
    row "$n" "MISSING" "required"; doctor_fail=1
  else
    row "$n" "-" "optional"
  fi
}

cmd_doctor() {
  doctor_fail=0
  printf 'Rust off Rails %s\n\n' "$(framework_version)"
  row "tool" "status" "version / note"
  probe rustc yes rustc rustc --version
  probe cargo yes cargo cargo --version
  probe sea-orm-cli yes sea-orm-cli sea-orm-cli --version
  probe cargo-nextest yes cargo-nextest cargo nextest --version
  probe cargo-watch no cargo-watch cargo watch --version
  probe docker no docker docker --version
  probe node no node node --version
  probe pnpm no pnpm pnpm --version
  probe claude no claude claude --version
  probe codex no codex codex --version
  if [ -f "$FW/AGENTS.md" ]; then row "framework" "ok" "$(cd "$FW" && pwd -P)"; else row "framework" "MISSING" "run the installer"; doctor_fail=1; fi
  if have claude; then
    if claude plugin list --json 2>/dev/null | grep -q '"offrails@offrails"'; then row "plugin" "ok" "offrails@offrails"; else row "plugin" "-" "not installed (offrails update)"; fi
  fi
  if have node; then
    major=$(node --version 2>/dev/null | sed 's/^v//; s/\..*//')
    [ "${major:-0}" -ge 24 ] 2>/dev/null || printf '\n  note: inertia/spa/islands apps need Node 24 LTS.\n'
  fi
  echo
  if [ "$doctor_fail" = 0 ]; then
    echo "All required tools are present."
  else
    echo "Some required tools are missing. Run: offrails update"
    return 1
  fi
}

# The app's vendored copy matches its conventions; apps from before 0.6.0 use the installed one.
cmd_check() {
  case "${1:-}" in -*) usage_error check "unknown option: $1" ;; esac
  [ $# -le 1 ] || usage_error check "too many arguments"
  dir=${1:-.}
  if [ -f "$dir/.offrails/tools/offrails-check" ]; then
    exec sh "$dir/.offrails/tools/offrails-check" "$dir"
  fi
  [ -f "$FW/tools/offrails-check" ] || die "no offrails-check in $FW; run: offrails update"
  exec sh "$FW/tools/offrails-check" "$dir"
}

cmd_update() {
  # Validate before downloading anything: an unknown flag must never reach a running installer.
  prev=""
  for a in "$@"; do
    if [ "$prev" = --version ]; then prev=""; continue; fi
    case "$a" in
      -y|--yes|--dry-run|--version=*|--no-toolchain|--no-agents) ;;
      --version) prev=--version ;;
      *) usage_error update "unknown option: $a" ;;
    esac
  done
  if [ -n "${OFFRAILS_SOURCE:-}" ] || ! have curl; then
    [ -f "$FW/install.sh" ] || die "no installer found; download $INSTALLER_URL"
    exec sh "$FW/install.sh" "$@"
  fi
  tmp=$(mktemp)
  if curl -fsSL "$INSTALLER_URL" -o "$tmp"; then
    sh "$tmp" "$@"; rc=$?; rm -f "$tmp"; exit "$rc"
  fi
  rm -f "$tmp"
  printf 'offrails: could not download %s; using the installed copy\n' "$INSTALLER_URL" >&2
  exec sh "$FW/install.sh" "$@"
}

cmd_uninstall() {
  case "${1:-}" in ""|-y|--yes) ;; *) usage_error uninstall "unknown option: $1" ;; esac
  printf 'This removes %s and %s/offrails.\nYour apps, Rust and the cargo tools are not touched.\n' "$OFFRAILS_HOME" "$BIN_DIR"
  if [ "${1:-}" != "-y" ] && [ "${1:-}" != "--yes" ]; then
    printf 'Continue? [y/N] '
    read -r a </dev/tty || a=n
    case "$a" in y|Y|yes) ;; *) echo "Cancelled."; return 0 ;; esac
  fi
  rm -rf "$OFFRAILS_HOME"
  rm -f "$BIN_DIR/offrails"
  echo "Removed."
  if have claude; then
    echo "To remove the Claude Code plugin too:"
    echo "  claude plugin uninstall offrails@offrails && claude plugin marketplace remove offrails"
  fi
}

YES=""
cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) if [ $# -gt 0 ]; then help_for "$1"; else usage; fi; exit 0 ;;
  version|--version|-V) cmd=version ;;
  new|check|doctor|update|upgrade|uninstall) ;;
  *) printf 'offrails: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
esac
# --help/-h anywhere after a command prints that command's help and does nothing else.
for arg in "$@"; do
  case "$arg" in -h|--help) help_for "$cmd"; exit 0 ;; esac
done
case "$cmd" in
  new) cmd_new "$@" ;;
  check) cmd_check "$@" ;;
  doctor) [ $# -eq 0 ] || usage_error doctor "unexpected argument: $1"; cmd_doctor ;;
  version) [ $# -eq 0 ] || usage_error version "unexpected argument: $1"; cmd_version ;;
  update) cmd_update "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
esac
